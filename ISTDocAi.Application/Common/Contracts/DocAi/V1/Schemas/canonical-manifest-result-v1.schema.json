{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:docai:canonical-manifest-result:v1",
  "title": "DocAi canonical manifest result v1",
  "type": "object",
  "required": [
    "contractVersion",
    "documentTypeCode",
    "shippingLineCode",
    "modelId",
    "pageCount",
    "header",
    "billsOfLading",
    "unidentifiedBillsOfLading",
    "unassignedContainers",
    "flags"
  ],
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "documentTypeCode": {
      "const": "MANIFEST"
    },
    "shippingLineCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "modelId": {
      "type": "string",
      "minLength": 1
    },
    "pageCount": {
      "type": "integer",
      "minimum": 1
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "reason"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "enum": [
              "LOW_CONFIDENCE",
              "CHECK_DIGIT",
              "BL_ROW_DROPPED",
              "ROW_MERGED",
              "ORPHAN_CONTAINER",
              "BL_REFERENCE_NOT_FOUND",
              "AMBIGUOUS_BL_REFERENCE",
              "ASSOCIATION_POSITION_MISSING",
              "ASSOCIATION_BY_POSITION",
              "TOTALS_MISMATCH",
              "TOTALS_UNVERIFIED"
            ]
          }
        }
      }
    },
    "header": {
      "type": "object",
      "properties": {
        "carrierName": {
          "$ref": "#/$defs/field"
        },
        "vesselName": {
          "$ref": "#/$defs/field"
        },
        "voyageNumber": {
          "$ref": "#/$defs/field"
        },
        "portOfLoading": {
          "$ref": "#/$defs/field"
        },
        "portOfDischarge": {
          "$ref": "#/$defs/field"
        },
        "manifestDate": {
          "$ref": "#/$defs/field"
        },
        "placeOfDelivery": {
          "$ref": "#/$defs/field"
        }
      },
      "additionalProperties": { "$ref": "#/$defs/field" }
    },
    "billsOfLading": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fields",
          "containers"
        ],
        "additionalProperties": false,
        "properties": {
          "fields": {
            "type": "object",
            "properties": {
              "billOfLadingNumber": {
                "$ref": "#/$defs/field"
              },
              "shipperAddress": {
                "$ref": "#/$defs/field"
              },
              "consigneeAddress": {
                "$ref": "#/$defs/field"
              },
              "shipperName": {
                "$ref": "#/$defs/field"
              },
              "consigneeName": {
                "$ref": "#/$defs/field"
              },
              "notifyParty": {
                "$ref": "#/$defs/field"
              },
              "bookingNumber": {
                "$ref": "#/$defs/field"
              },
              "freightTerms": {
                "$ref": "#/$defs/field"
              },
              "packages": {
                "$ref": "#/$defs/field"
              },
              "grossWeight": {
                "$ref": "#/$defs/field"
              },
              "description": {
                "$ref": "#/$defs/field"
              },
              "containerCount": {
                "$ref": "#/$defs/field"
              },
              "hsCode": {
                "$ref": "#/$defs/field"
              },
              "packageType": {
                "$ref": "#/$defs/field"
              },
              "issueDate": {
                "$ref": "#/$defs/field"
              }
            },
            "additionalProperties": { "$ref": "#/$defs/field" }
          },
          "containers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/container"
            }
          }
        }
      }
    },
    "unassignedContainers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/container"
      }
    },
    "unidentifiedBillsOfLading": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceIndex",
          "fields"
        ],
        "additionalProperties": false,
        "properties": {
          "sourceIndex": {
            "type": "integer",
            "minimum": 0
          },
          "fields": {
            "type": "object",
            "properties": {
              "billOfLadingNumber": {
                "$ref": "#/$defs/field"
              },
              "shipperAddress": {
                "$ref": "#/$defs/field"
              },
              "consigneeAddress": {
                "$ref": "#/$defs/field"
              },
              "shipperName": {
                "$ref": "#/$defs/field"
              },
              "consigneeName": {
                "$ref": "#/$defs/field"
              },
              "notifyParty": {
                "$ref": "#/$defs/field"
              },
              "bookingNumber": {
                "$ref": "#/$defs/field"
              },
              "freightTerms": {
                "$ref": "#/$defs/field"
              },
              "packages": {
                "$ref": "#/$defs/field"
              },
              "grossWeight": {
                "$ref": "#/$defs/field"
              },
              "description": {
                "$ref": "#/$defs/field"
              },
              "containerCount": {
                "$ref": "#/$defs/field"
              },
              "hsCode": {
                "$ref": "#/$defs/field"
              },
              "packageType": {
                "$ref": "#/$defs/field"
              },
              "issueDate": {
                "$ref": "#/$defs/field"
              }
            },
            "additionalProperties": { "$ref": "#/$defs/field" }
          }
        }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": [
        "value",
        "confidence",
        "page"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "rawText": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "billOfLadingNumber": {
          "$ref": "#/$defs/field"
        },
        "containerNumber": {
          "$ref": "#/$defs/field"
        },
        "sealNumber": {
          "$ref": "#/$defs/field"
        },
        "containerType": {
          "$ref": "#/$defs/field"
        },
        "packages": {
          "$ref": "#/$defs/field"
        },
        "grossWeight": {
          "$ref": "#/$defs/field"
        },
        "description": {
          "$ref": "#/$defs/field"
        },
        "associationMethod": {
          "enum": [
            "blNumber",
            "position"
          ]
        }
      }
    }
  }
}
