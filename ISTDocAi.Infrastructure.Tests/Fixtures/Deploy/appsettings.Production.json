{
    "TemplateEndpoints":  {
                              "Enabled":  false
                          },
    "ConnectionStrings":  {
                              "DefaultConnection":  "Server=FAKE-SQL;Database=DocAi;Integrated Security=True;Encrypt=True;TrustServerCertificate=False"
                          },
    "Serilog":  {
                    "MinimumLevel":  {
                                         "Default":  "Information",
                                         "Override":  {
                                                          "Microsoft":  "Warning",
                                                          "System":  "Warning"
                                                      }
                                     },
                    "WriteTo":  [
                                    {
                                        "Name":  "Console"
                                    }
                                ]
                },
    "RateLimiting":  {
                         "Enabled":  true,
                         "Global":  {
                                        "PermitLimit":  300,
                                        "WindowSeconds":  60,
                                        "SegmentsPerWindow":  6,
                                        "QueueLimit":  20
                                    },
                         "Auth":  {
                                      "PermitLimit":  10,
                                      "WindowSeconds":  60,
                                      "QueueLimit":  0
                                  }
                     },
    "ReportToken":  {
                        "LifetimeSeconds":  120
                    },
    "AllowedHosts":  "*",
    "DocAi":  {
                  "KeyVault":  {
                                   "Url":  ""
                               },
                  "Sql":  {
                              "CommandTimeoutSeconds":  30
                          },
                  "Blob":  {
                               "AccountUrl":  "https://fakebaseline.blob.core.windows.net",
                               "Container":  "documents",
                               "ManagedIdentityClientId":  null
                           },
                  "RateLimit":  {
                                    "TokenLimit":  60,
                                    "TokensPerPeriod":  30,
                                    "PeriodSeconds":  1
                                },
                  "FileInspection":  {
                                         "TimeoutSeconds":  5
                                     },
                  "Identity":  {
                                   "StoreLocation":  "LocalMachine",
                                   "TenantId":  "00000000-0000-4000-8000-000000000001",
                                   "CertificateThumbprint":  "0000000000000000000000000000000000000000",
                                   "ClientId":  "00000000-0000-4000-8000-000000000002",
                                   "Mode":  "ClientCertificate"
                               },
                  "DocumentIntelligence":  {
                                               "Endpoint":  "https://fakebaseline.cognitiveservices.azure.com"
                                           },
                  "Secrets":  {
                                  "ProtectedFile":  {
                                                        "Path":  "C:\\ProgramData\\DocAi\\secrets\\webhook-secrets.json"
                                                    },
                                  "Provider":  "ProtectedFile"
                              },
                  "Database":  {
                                   "CommandTimeoutSeconds":  300,
                                   "MigrateOnStartup":  true,
                                   "AllowDatabaseCreation":  true,
                                   "InitializationTimeoutSeconds":  900
                               }
              },
    "Webhooks":  {
                     "Enabled":  true,
                     "MaxParallelSends":  4
                 },
    "Worker":  {
                   "MaxParallelJobs":  4,
                   "Enabled":  true
               },
    "Retention":  {
                      "RunAtUtc":  "02:00:00",
                      "Enabled":  true
                  },
    "Signals":  {
                    "Enabled":  true
                }
}
